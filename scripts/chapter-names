#!/usr/bin/env python3
"""Keep manuscript file names in step with chapter titles.

Chapter files are named  manuscript/chNN-<slug>.md  where NN is the chapter
number (the chapter's id; bible citations use chNN) and <slug> is the title
from the chapter heading, e.g.

    CHAPTER 5 — The Crossing   ->  ch05-the-crossing.md

Usage:
    scripts/chapter-names            rename files whose slug no longer matches the heading (git mv)
    scripts/chapter-names --check    list mismatches; exit 1 if any
    scripts/chapter-names --slug "Title"   print the slug for a title
"""
import os
import re
import subprocess
import sys

MANUSCRIPT = "manuscript"
FILE_RE = re.compile(r"^ch(\d{2,})(?:-[a-z0-9-]*)?\.md$")
HEADING_RE = re.compile(r"^CHAPTER\s+\d+\s*[—–-]+\s*(?P<title>.+?)\s*$", re.I)
ATX_RE = re.compile(r"^#{1,6}\s+(?P<title>.+?)\s*#*\s*$")


def slugify(title):
    s = re.sub(r"[*_`]", "", title).lower()
    s = re.sub(r"['’]", "", s)
    s = re.sub(r"[^a-z0-9]+", "-", s)
    return s.strip("-") or "untitled"


def chapter_title(path):
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            m = HEADING_RE.match(line)
            if m:
                return m.group("title")
            m = ATX_RE.match(line)
            if m and not re.match(r"(part|interlude)\b", m.group("title"), re.I):
                inner = HEADING_RE.match(m.group("title"))
                return inner.group("title") if inner else m.group("title")
    return None


def plan():
    moves = []
    for name in sorted(os.listdir(MANUSCRIPT)):
        m = FILE_RE.match(name)
        if not m:
            continue
        path = os.path.join(MANUSCRIPT, name)
        title = chapter_title(path)
        if title is None:
            print(f"warning: no chapter heading in {path}", file=sys.stderr)
            continue
        want = f"ch{m.group(1)}-{slugify(title)}.md"
        if want != name:
            moves.append((path, os.path.join(MANUSCRIPT, want)))
    return moves


def main(argv):
    if argv[:1] == ["--slug"]:
        print(slugify(" ".join(argv[1:])))
        return 0
    moves = plan()
    if "--check" in argv:
        for src, dst in moves:
            print(f"{src} -> {dst}")
        return 1 if moves else 0
    for src, dst in moves:
        if os.path.exists(dst):
            print(f"skip {src}: {dst} already exists", file=sys.stderr)
            continue
        subprocess.run(["git", "mv", src, dst], check=True)
        print(f"renamed {src} -> {dst}")
    if not moves:
        print("All chapter file names match their headings.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
