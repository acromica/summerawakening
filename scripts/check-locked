#!/usr/bin/env python3
"""Verify that no LOCKED span changed between HEAD and the index (staged changes).

A LOCKED span is the text between <!-- LOCKED --> and <!-- /LOCKED --> in manuscript/.
Spans are compared as a multiset across all manuscript files, so renaming or
moving a chapter file is fine; changing, adding, or removing a span is not.
The commit-msg hook runs this for every commit that is not an author edit.

usage: scripts/check-locked          exit 1 if any LOCKED span differs
"""
import re
import subprocess
import sys
from collections import Counter

LOCK_RE = re.compile(r"<!--\s*LOCKED\s*-->(.*?)<!--\s*/LOCKED\s*-->", re.S)
MARK_RE = re.compile(r"<!--\s*/?LOCKED\s*-->")


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True)


def spans(rev_prefix, paths):
    found = Counter()
    where = {}
    markers = 0
    for p in paths:
        r = git("show", f"{rev_prefix}{p}")
        if r.returncode:
            continue
        markers += len(MARK_RE.findall(r.stdout))
        for m in LOCK_RE.finditer(r.stdout):
            found[m.group(1)] += 1
            where.setdefault(m.group(1), p)
    return found, where, markers


def main():
    if git("rev-parse", "--verify", "-q", "HEAD").returncode:
        return 0  # first commit: nothing locked yet
    head_paths = git("ls-tree", "-r", "--name-only", "HEAD", "--", "manuscript").stdout.split()
    index_paths = git("ls-files", "--", "manuscript").stdout.split()
    before, where, m_before = spans("HEAD:", head_paths)
    after, _, m_after = spans(":", index_paths)
    if before == after and m_before == m_after:
        return 0
    for text, n in (before - after).items():
        snippet = " ".join(text.split())[:90]
        print(f"LOCKED span changed or removed ({where[text]}): \"{snippet}…\"")
    if after - before:
        print(f"{sum((after - before).values())} new or altered LOCKED span(s) in the staged text.")
    if m_before != m_after:
        print(f"LOCKED markers: {m_before} in HEAD, {m_after} staged.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
